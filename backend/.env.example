# Credentials and test database are optional until their features are used.
APP_NAME=Agentic AI Travel Planner
APP_ENV=development
APP_DEBUG=false
API_V1_PREFIX=/api/v1
# Enable saved-trip history for local development; deletion stays restricted.
TRIP_HISTORY_API_ENABLED=true
FRONTEND_URL=http://localhost:5173
# JSON array format is parsed by Pydantic Settings.
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

GEMINI_API_KEY=replace_with_gemini_api_key
GEMINI_MODEL=gemini-2.5-flash-lite
GEMINI_TIMEOUT_SECONDS=30
GEMINI_MAX_RETRIES=2
GEOAPIFY_API_KEY=replace_with_geoapify_api_key
OPENROUTESERVICE_API_KEY=replace_with_openrouteservice_api_key
TAVILY_API_KEY=replace_with_tavily_api_key
# Optional authorized production pricing. Keep the test environment until a
# production Amadeus application has been configured and reviewed.
AMADEUS_API_KEY=replace_with_amadeus_api_key
AMADEUS_API_SECRET=replace_with_amadeus_api_secret
AMADEUS_ENVIRONMENT=test

# Transparent non-live planning estimates and dated reference FX.
AUTOMATIC_COST_ESTIMATION_ENABLED=true
# Leave unset to use backend/data/cost_references.json.
# COST_REFERENCE_FILE=C:/absolute/path/to/reviewed_cost_references.json
DEFAULT_ESTIMATE_CONTINGENCY_PERCENT=10
REFERENCE_FX_ENABLED=true
REFERENCE_FX_MAX_AGE_DAYS=7

DATABASE_URL=replace_with_database_url
# Use only a separate database whose name includes "test"; integration tests may
# create and drop their own temporary schema in this dedicated database.
TEST_DATABASE_URL=replace_with_dedicated_test_database_url
UPSTASH_REDIS_REST_URL=replace_with_upstash_redis_rest_url
UPSTASH_REDIS_REST_TOKEN=replace_with_upstash_redis_rest_token
UPSTASH_REDIS_TIMEOUT_SECONDS=5
REDIS_TASK_STATUS_TTL_SECONDS=86400
EXTERNAL_API_TIMEOUT_SECONDS=10
EXTERNAL_API_MAX_RETRIES=2
TRIP_WORKFLOW_TIMEOUT_SECONDS=180
TRIP_AGENT_TIMEOUT_SECONDS=60
TRIP_MAX_REVISIONS=2
# Durable PostgreSQL-backed planning jobs. A separate worker process may use
# `python -m app.worker` with TRIP_WORKER_ENABLED=false on the API service.
TRIP_EXECUTION_MODE=database_worker
TRIP_WORKER_ENABLED=true
TRIP_JOB_LEASE_SECONDS=45
TRIP_JOB_MAX_ATTEMPTS=3
TRIP_WORKER_POLL_SECONDS=2
# Keep false unless an authenticated/private administrative boundary exists.
TRIP_ADMIN_API_ENABLED=false
